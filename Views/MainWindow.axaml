<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:x_pad.ViewModels"
        xmlns:views="using:x_pad.Views"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dockFactory="using:Dock.Model.Avalonia"
        xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="x_pad.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/xpad.ico"
        Title="{Binding SelectedTab.Title, StringFormat='X-Pad - {0}', FallbackValue='X-Pad'}"
        MinWidth="600"
        MinHeight="400"
        RequestedThemeVariant="Dark"
        Topmost="{Binding AlwaysOnTop}"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- KeyBindings are applied at runtime from KeyBindingCatalog + settings overrides. -->

    <Window.Styles>
        <Style Selector="dock|DocumentTabStripItem">
            <!-- Avalonia forbids Control instances as Setter values; Template creates one per tab. -->
            <Setter Property="DocumentContextMenu">
                <Template>
                    <ContextMenu x:DataType="dockModel:Document">
                        <MenuItem Header="Add to _Favorites"
                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AddFavoriteCommand}"
                                  CommandParameter="{Binding Context}" />
                        <MenuItem Header="Copy Full _Path"
                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CopyFullPathCommand}"
                                  CommandParameter="{Binding Context}" />
                        <MenuItem Header="Reveal in E_xplorer"
                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RevealInExplorerCommand}"
                                  CommandParameter="{Binding Context}" />
                        <Separator />
                        <MenuItem Header="_Close Tab"
                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                  CommandParameter="{Binding Context}" />
                    </ContextMenu>
                </Template>
            </Setter>
        </Style>
    </Window.Styles>

    <ThemeVariantScope x:Name="AppChromeScope" RequestedThemeVariant="Dark">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource XPadChromeAltBrush}"
                BorderBrush="{DynamicResource XPadChromeHoverBrush}"
                BorderThickness="0,0,0,1">
        <Menu Background="{DynamicResource XPadChromeAltBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewTabCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="New _Window" Command="{Binding NewWindowCommand}" InputGesture="Ctrl+Shift+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="Open Fol_der..." Command="{Binding OpenFolderCommand}" InputGesture="Ctrl+Shift+O" />
                <MenuItem Header="Close Folde_r" Command="{Binding CloseFolderCommand}" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <MenuItem Header="Clear Recent Files" Command="{Binding ClearRecentFilesCommand}" />
                <MenuItem Header="_Favorites">
                    <MenuItem Header="_Add Current File"
                              Command="{Binding AddFavoriteCommand}"
                              CommandParameter="{Binding SelectedTab}" />
                    <MenuItem Header="Re_move Current File"
                              Command="{Binding RemoveFavoriteCommand}"
                              CommandParameter="{Binding SelectedTab}" />
                    <Separator />
                    <MenuItem Header="_Open" ItemsSource="{Binding FavoriteMenuItems}">
                        <MenuItem.Styles>
                            <Style Selector="MenuItem > MenuItem" x:DataType="vm:FavoriteMenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenFavoriteCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding Path=Path}" />
                                <Setter Property="ToolTip.Tip" Value="{Binding Path=Path}" />
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem Header="Clear Favorites" Command="{Binding ClearFavoritesCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveFileAsCommand}" InputGesture="Ctrl+Shift+S" />
                <MenuItem Header="Save A_ll" Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Alt+S" />
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGesture="Ctrl+Alt+P" />
                <MenuItem Header="Export as P_DF..." Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="Copy Full _Path" Command="{Binding CopyFullPathCommand}" />
                <MenuItem Header="Reveal in E_xplorer" Command="{Binding RevealInExplorerCommand}" />
                <MenuItem Header="_Reload from Disk" Command="{Binding ReloadFromDiskCommand}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" InputGesture="Ctrl+W" />
                <MenuItem Header="Reopen Closed Tab" Command="{Binding ReopenClosedTabCommand}" InputGesture="Ctrl+Shift+T" />
                <MenuItem Header="Close _Others" Command="{Binding CloseOthersCommand}" />
                <MenuItem Header="Close _All" Command="{Binding CloseAllCommand}" />
                <Separator />
                <MenuItem Header="_Encoding">
                    <MenuItem Header="UTF-8" Command="{Binding SetEncodingUtf8Command}" />
                    <MenuItem Header="UTF-8 with BOM" Command="{Binding SetEncodingUtf8BomCommand}" />
                    <MenuItem Header="UTF-16 LE" Command="{Binding SetEncodingUtf16LeCommand}" />
                    <MenuItem Header="UTF-16 BE" Command="{Binding SetEncodingUtf16BeCommand}" />
                    <MenuItem Header="Latin-1" Command="{Binding SetEncodingLatin1Command}" />
                </MenuItem>
                <MenuItem Header="Read-_only"
                         ToggleType="CheckBox"
                         IsChecked="{Binding SelectedTab.IsReadOnly, Mode=OneWay}"
                         Command="{Binding ToggleReadOnlyCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                <Separator />
                <MenuItem Header="_Duplicate Line" Command="{Binding DuplicateLineCommand}" InputGesture="Shift+Alt+Down" />
                <MenuItem Header="Move Line _Up" Command="{Binding MoveLineUpCommand}" InputGesture="Alt+Up" />
                <MenuItem Header="Move Line _Down" Command="{Binding MoveLineDownCommand}" InputGesture="Alt+Down" />
                <Separator />
                <MenuItem Header="Toggle Line _Comment" Command="{Binding ToggleLineCommentCommand}" InputGesture="Ctrl+OemQuestion" />
                <MenuItem Header="_Transform">
                    <MenuItem Header="_Upper Case" Command="{Binding UpperCaseCommand}" InputGesture="Ctrl+U" />
                    <MenuItem Header="_Lower Case" Command="{Binding LowerCaseCommand}" InputGesture="Ctrl+Shift+U" />
                    <MenuItem Header="_Title Case" Command="{Binding TitleCaseCommand}" />
                    <Separator />
                    <MenuItem Header="Sort Lines A→_Z" Command="{Binding SortLinesAscendingCommand}" />
                    <MenuItem Header="Sort Lines Z→A" Command="{Binding SortLinesDescendingCommand}" />
                    <MenuItem Header="_Join Lines" Command="{Binding JoinLinesCommand}" InputGesture="Ctrl+J" />
                    <MenuItem Header="Remove _Empty Lines" Command="{Binding RemoveEmptyLinesCommand}" />
                    <MenuItem Header="Remove Duplicate Lines" Command="{Binding RemoveDuplicateLinesCommand}" />
                    <MenuItem Header="Trim Trailing _Whitespace" Command="{Binding TrimTrailingWhitespaceCommand}" />
                </MenuItem>
                <MenuItem Header="_Format Document" Command="{Binding FormatDocumentCommand}" InputGesture="Shift+Alt+F" />
                <MenuItem Header="Insert Date/_Time" Command="{Binding InsertDateTimeCommand}" InputGesture="F5" />
            </MenuItem>
            <MenuItem Header="_Selection">
                <MenuItem Header="_Invert Selection" Command="{Binding InvertSelectionCommand}" />
                <MenuItem Header="Select Current _Line" Command="{Binding SelectCurrentLineCommand}" InputGesture="Ctrl+L" />
                <MenuItem Header="Add Next _Occurrence" Command="{Binding AddNextOccurrenceCommand}" InputGesture="Ctrl+D" />
                <MenuItem Header="Select All Occurren_ces" Command="{Binding SelectAllOccurrencesCommand}" InputGesture="Ctrl+Shift+L" />
                <MenuItem Header="Jump to Matching _Bracket" Command="{Binding JumpToMatchingBracketCommand}" InputGesture="Ctrl+Shift+OemPipe" />
            </MenuItem>
            <MenuItem Header="F_ind">
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGesture="Ctrl+F" />
                <MenuItem Header="Find _Next" Command="{Binding FindNextCommand}" InputGesture="F3" />
                <MenuItem Header="Find Pre_vious" Command="{Binding FindPreviousCommand}" InputGesture="Shift+F3" />
                <MenuItem Header="_Replace..." Command="{Binding ReplaceCommand}" InputGesture="Ctrl+H" />
                <MenuItem Header="Find in Open _Tabs..." Command="{Binding FindInOpenTabsCommand}" InputGesture="Ctrl+Shift+F" />
                <MenuItem Header="Find in Fol_der..." Command="{Binding FindInFolderCommand}" InputGesture="Ctrl+Shift+H" />
                <Separator />
                <MenuItem Header="_Go to Line..." Command="{Binding GoToLineCommand}" InputGesture="Ctrl+G" />
                <MenuItem Header="Search _Web" Command="{Binding SearchWebCommand}" />
                <MenuItem Header="Trigger _Completions" Command="{Binding TriggerCompletionsCommand}" InputGesture="Ctrl+Space" />
                <Separator />
                <MenuItem Header="Go to _Definition" Command="{Binding GoToDefinitionCommand}" InputGesture="F12" />
                <MenuItem Header="Find _References" Command="{Binding FindReferencesCommand}" InputGesture="Shift+F12" />
                <MenuItem Header="Document Out_line..." Command="{Binding ShowDocumentOutlineCommand}" InputGesture="Ctrl+Shift+." />
                <MenuItem Header="Code _Actions..." Command="{Binding ShowCodeActionsCommand}" InputGesture="Ctrl+." />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Explorer"
                         ToggleType="CheckBox"
                         IsChecked="{Binding IsExplorerVisible, Mode=OneWay}"
                         Command="{Binding ToggleExplorerCommand}"
                         InputGesture="Ctrl+B" />
                <MenuItem Header="_Word Wrap"
                         ToggleType="CheckBox"
                         IsChecked="{Binding SelectedTab.WordWrap, Mode=OneWay}"
                         Command="{Binding ToggleWordWrapCommand}"
                         InputGesture="Alt+Z" />
                <MenuItem Header="Show White_space"
                         ToggleType="CheckBox"
                         IsChecked="{Binding ShowWhitespace}" />
                <MenuItem Header="Always on _Top"
                         ToggleType="CheckBox"
                         IsChecked="{Binding AlwaysOnTop}" />
                <MenuItem Header="_Terminal"
                         ToggleType="CheckBox"
                         IsChecked="{Binding IsTerminalVisible, Mode=OneWay}"
                         Command="{Binding ToggleTerminalCommand}"
                         InputGesture="Ctrl+OemTilde" />
                <MenuItem Header="_Split">
                    <MenuItem Header="_Vertical"
                             ToggleType="CheckBox"
                             IsChecked="{Binding IsSplitVerticalActive, Mode=OneWay}"
                             Command="{Binding ToggleSplitVerticalCommand}" />
                    <MenuItem Header="_Horizontal"
                             ToggleType="CheckBox"
                             IsChecked="{Binding IsSplitHorizontalActive, Mode=OneWay}"
                             Command="{Binding ToggleSplitHorizontalCommand}" />
                </MenuItem>
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
                    <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
                    <MenuItem Header="Zoom _Reset" Command="{Binding ZoomResetCommand}" InputGesture="Ctrl+D0" />
                </MenuItem>
                <MenuItem Header="_Tabs">
                    <MenuItem Header="Next Tab" Command="{Binding NextTabCommand}" InputGesture="Ctrl+Tab" />
                    <MenuItem Header="Previous Tab" Command="{Binding PreviousTabCommand}" InputGesture="Ctrl+Shift+Tab" />
                    <MenuItem Header="Move Tab _Left" Command="{Binding MoveTabLeftCommand}" InputGesture="Ctrl+Shift+PageUp" />
                    <MenuItem Header="Move Tab _Right" Command="{Binding MoveTabRightCommand}" InputGesture="Ctrl+Shift+PageDown" />
                </MenuItem>
                <MenuItem Header="_Folding">
                    <MenuItem Header="_Fold All" Command="{Binding FoldAllCommand}" />
                    <MenuItem Header="_Unfold All" Command="{Binding UnfoldAllCommand}" />
                </MenuItem>
                <MenuItem Header="_Bookmarks">
                    <MenuItem Header="Toggle _Bookmark" Command="{Binding ToggleBookmarkCommand}" InputGesture="Ctrl+F2" />
                    <MenuItem Header="_Next Bookmark" Command="{Binding NextBookmarkCommand}" InputGesture="F2" />
                    <MenuItem Header="_Previous Bookmark" Command="{Binding PreviousBookmarkCommand}" InputGesture="Shift+F2" />
                    <MenuItem Header="Clear Book_marks" Command="{Binding ClearBookmarksCommand}" />
                </MenuItem>
                <MenuItem Header="T_heme">
                    <MenuItem Header="_Dark"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeDark}" />
                    <MenuItem Header="_Light"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeLight}" />
                    <MenuItem Header="_System"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeSystem}" />
                    <MenuItem Header="_Monokai"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeMonokai}" />
                    <MenuItem Header="_Hacker"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeHacker}" />
                    <MenuItem Header="_AMOLED"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeAmoled}" />
                    <MenuItem Header="_GitHub"
                             ToggleType="Radio"
                             GroupName="AppTheme"
                             IsChecked="{Binding IsThemeGithub}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Preferences..." Command="{Binding OpenPreferencesCommand}" InputGesture="Ctrl+OemComma" />
                <MenuItem Header="Command _Palette..." Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+P" />
                <MenuItem Header="Quick _Open..." Command="{Binding OpenQuickOpenCommand}" InputGesture="Ctrl+P" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Install _Send To shortcut" Command="{Binding InstallSendToCommand}" />
                <MenuItem Header="Register Open _With (text types)" Command="{Binding RegisterOpenWithCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="_About X-Pad" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Classes="statusBar"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedTab.FilePath, FallbackValue=''}"
                           ToolTip.Tip="{Binding SelectedTab.FilePath}"
                           MaxWidth="260"
                           TextTrimming="CharacterEllipsis"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="2"
                        Classes="quiet"
                        Margin="4,0"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleReadOnlyCommand}"
                        ToolTip.Tip="Toggle read-only for this buffer"
                        IsVisible="{Binding SelectedTab.IsReadOnly}">
                    <TextBlock Text="RO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button Grid.Column="3"
                        Classes="quiet"
                        Margin="4,0"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="Syntax language (click to override)">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuItem Header="Auto (from file)" Command="{Binding SetLanguageCommand}" CommandParameter="" />
                            <Separator />
                            <MenuItem Header="Plain Text" Command="{Binding SetLanguageCommand}" CommandParameter=".txt" />
                            <MenuItem Header="C#" Command="{Binding SetLanguageCommand}" CommandParameter=".cs" />
                            <MenuItem Header="C / C++" Command="{Binding SetLanguageCommand}" CommandParameter=".cpp" />
                            <MenuItem Header="CSS" Command="{Binding SetLanguageCommand}" CommandParameter=".css" />
                            <MenuItem Header="Go" Command="{Binding SetLanguageCommand}" CommandParameter=".go" />
                            <MenuItem Header="HTML" Command="{Binding SetLanguageCommand}" CommandParameter=".html" />
                            <MenuItem Header="Java" Command="{Binding SetLanguageCommand}" CommandParameter=".java" />
                            <MenuItem Header="JavaScript" Command="{Binding SetLanguageCommand}" CommandParameter=".js" />
                            <MenuItem Header="JSON" Command="{Binding SetLanguageCommand}" CommandParameter=".json" />
                            <MenuItem Header="Markdown" Command="{Binding SetLanguageCommand}" CommandParameter=".md" />
                            <MenuItem Header="PowerShell" Command="{Binding SetLanguageCommand}" CommandParameter=".ps1" />
                            <MenuItem Header="Python" Command="{Binding SetLanguageCommand}" CommandParameter=".py" />
                            <MenuItem Header="Rust" Command="{Binding SetLanguageCommand}" CommandParameter=".rs" />
                            <MenuItem Header="Shell" Command="{Binding SetLanguageCommand}" CommandParameter=".sh" />
                            <MenuItem Header="SQL" Command="{Binding SetLanguageCommand}" CommandParameter=".sql" />
                            <MenuItem Header="TypeScript" Command="{Binding SetLanguageCommand}" CommandParameter=".ts" />
                            <MenuItem Header="XML" Command="{Binding SetLanguageCommand}" CommandParameter=".xml" />
                            <MenuItem Header="YAML" Command="{Binding SetLanguageCommand}" CommandParameter=".yaml" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="{Binding SelectedTab.Language, FallbackValue='Plain Text'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button Grid.Column="4"
                        Classes="quiet"
                        Margin="4,0"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CycleEncodingCommand}"
                        ToolTip.Tip="Cycle file encoding (re-decodes from disk bytes)">
                    <TextBlock Text="{Binding SelectedTab.Encoding, FallbackValue='UTF-8'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button Grid.Column="5"
                        Classes="quiet"
                        Margin="4,0"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CycleLineEndingCommand}"
                        ToolTip.Tip="Cycle line ending (LF / CRLF / CR)">
                    <TextBlock Text="{Binding SelectedTab.LineEnding, FallbackValue='LF'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button Grid.Column="6"
                        Classes="quiet"
                        Margin="4,0"
                        Padding="6,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CycleIndentStyleCommand}"
                        ToolTip.Tip="Toggle Tab vs Spaces for this buffer">
                    <TextBlock Text="{Binding SelectedTab.IndentStyle, FallbackValue='Spaces'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <TextBlock Grid.Column="7"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Ln {0}, Col {1}">
                            <Binding Path="SelectedTab.LineNumber" />
                            <Binding Path="SelectedTab.ColumnNumber" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="8"
                           Text="{Binding SelectedTab.LineCount, StringFormat='Lines: {0}'}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="9"
                           Text="{Binding SelectedTab.FontSize, StringFormat='{}{0:0}px'}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <dock:DockControl x:Name="DockHost"
                          InitializeLayout="True"
                          InitializeFactory="True">
            <dock:DockControl.Factory>
                <dockFactory:Factory />
            </dock:DockControl.Factory>
            <dockModel:RootDock Id="Root" IsCollapsable="False">
                <dockModel:ProportionalDock x:Name="MainDock" Orientation="Vertical">
                    <dockModel:ProportionalDock Orientation="Horizontal">
                        <dockModel:ToolDock Id="ExplorerToolDock"
                                            Alignment="Left"
                                            Proportion="0.22" />
                        <dockModel:ProportionalDockSplitter />
                        <dockModel:DocumentDock Id="Documents"
                                                CanCreateDocument="False">
                            <dockModel:DocumentDock.DocumentTemplate>
                                <dockModel:DocumentTemplate>
                                    <Panel x:DataType="dockModel:Document">
                                        <views:DocumentEditor DataContext="{Binding Context}"
                                                               x:DataType="vm:DocumentViewModel" />
                                    </Panel>
                                </dockModel:DocumentTemplate>
                            </dockModel:DocumentDock.DocumentTemplate>
                        </dockModel:DocumentDock>
                    </dockModel:ProportionalDock>
                    <dockModel:ProportionalDockSplitter />
                    <dockModel:ToolDock Id="TerminalToolDock" Proportion="0.28" />
                </dockModel:ProportionalDock>
            </dockModel:RootDock>
        </dock:DockControl>
    </DockPanel>
    </ThemeVariantScope>
</Window>
