<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:x_pad.ViewModels"
             x:Class="x_pad.Views.FileTreePanel"
             x:DataType="vm:FileTreeViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="8,6"
                   FontSize="11"
                   Opacity="0.7"
                   Text="{Binding RootPath, FallbackValue='No folder'}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding RootPath}"
                   IsVisible="{Binding HasWorkspace}" />
        <TextBlock Margin="16,24"
                   FontSize="12"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Text="Open a folder (Ctrl+Shift+O)"
                   IsVisible="{Binding !HasWorkspace}" />
        <TreeView ItemsSource="{Binding Roots}"
                  DoubleTapped="OnTreeDoubleTapped"
                  KeyDown="OnTreeKeyDown"
                  IsVisible="{Binding HasWorkspace}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}"
                                  DataType="vm:FileTreeNode">
                    <TextBlock Text="{Binding Name}" FontSize="12" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FileTreeNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>
        </TreeView>
    </DockPanel>
</UserControl>
