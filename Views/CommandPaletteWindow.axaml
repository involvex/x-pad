<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:x_pad.Views"
        x:Class="x_pad.Views.CommandPaletteWindow"
        Title="Command Palette"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="12">
        <TextBox x:Name="FilterBox"
                 DockPanel.Dock="Top"
                 PlaceholderText="Type a command or recent file…"
                 FontSize="14"
                 Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Opacity="0.65"
                   Text="Enter run · Esc cancel · ↑↓ navigate" />
        <ListBox x:Name="ResultsList"
                 FontSize="13"
                 DoubleTapped="OnResultsDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="views:PaletteEntry">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Detail}"
                                   Opacity="0.55"
                                   Margin="12,0,0,0"
                                   FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
