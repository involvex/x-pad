<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:x_pad.Views"
        x:Class="x_pad.Views.FindReferencesWindow"
        Title="Find References"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="420"
        MinHeight="280">
    <DockPanel Margin="12">
        <TextBlock x:Name="SummaryBox"
                   DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Opacity="0.65"
                   Text="Enter jump · Esc close" />
        <ListBox x:Name="ResultsList"
                 FontSize="12"
                 DoubleTapped="OnResultsDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="views:ReferenceHit">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
