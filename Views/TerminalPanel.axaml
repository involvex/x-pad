<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terminal="using:Iciclecreek.Terminal"
             x:Class="x_pad.Views.TerminalPanel"
             MinHeight="120">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource XPadChromeAltBrush}"
                Padding="8,4"
                BorderBrush="{DynamicResource XPadChromeHoverBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock x:Name="TitleBlock"
                           Grid.Column="0"
                           Text="Terminal"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource XPadChromeTextMutedBrush}" />
                <Button Grid.Column="1"
                        Classes="quiet"
                        Content="cd here"
                        Margin="4,0"
                        Padding="8,2"
                        ToolTip.Tip="cd to current file folder"
                        Click="OnCdHere" />
                <Button Grid.Column="2"
                        Classes="quiet"
                        Content="New"
                        Margin="4,0"
                        Padding="8,2"
                        ToolTip.Tip="Restart shell"
                        Click="OnNewSession" />
                <Button Grid.Column="3"
                        Classes="quiet"
                        Content="Kill"
                        Margin="4,0"
                        Padding="8,2"
                        Click="OnKill" />
                <Button Grid.Column="4"
                        Classes="quiet"
                        Content="×"
                        Width="28"
                        Padding="0"
                        ToolTip.Tip="Hide terminal"
                        Click="OnHide" />
            </Grid>
        </Border>
        <terminal:TerminalControl x:Name="Terminal"
                                  FontFamily="Cascadia Mono, Cascadia Code, Consolas, monospace"
                                  FontSize="13"
                                  BufferSize="2000"
                                  Background="#0C0C0C"
                                  Foreground="#CCCCCC" />
    </DockPanel>
</UserControl>
