<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:x_pad.ViewModels"
             x:Class="x_pad.Views.DocumentEditor"
             x:DataType="vm:DocumentViewModel">
    <Grid x:Name="SplitRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Editor + VS Code–style ghost overlay (real UI; AvaloniaEdit Caret-layer redraw is unreliable). -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="3"
              Grid.ColumnSpan="1">
            <AvaloniaEdit:TextEditor x:Name="Editor"
                                     ShowLineNumbers="True"
                                     FontSize="{Binding FontSize}"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     WordWrap="{Binding WordWrap}" />
            <Canvas x:Name="GhostOverlay"
                    IsHitTestVisible="False"
                    ClipToBounds="True">
                <Border x:Name="GhostToolbar"
                        IsVisible="False"
                        IsHitTestVisible="True"
                        Background="#2D2D2D"
                        BorderBrush="#454545"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Cursor="Hand"
                        ZIndex="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Accept"
                                   FontSize="11"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center" />
                        <Border BorderBrush="#6A6A6A"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="Tab"
                                       FontSize="10"
                                       Foreground="#E0E0E0" />
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="GhostPreviewText"
                           IsVisible="False"
                           IsHitTestVisible="False"
                           FontStyle="Italic"
                           Foreground="#A0A0A0"
                           Opacity="0.9"
                           ZIndex="1" />
            </Canvas>
        </Grid>

        <GridSplitter x:Name="VerticalSplitter"
                      Grid.Row="0"
                      Grid.Column="1"
                      Grid.RowSpan="3"
                      Width="4"
                      ResizeDirection="Columns"
                      IsVisible="False"
                      Background="{DynamicResource CardStrokeColorDefaultBrush}" />

        <GridSplitter x:Name="HorizontalSplitter"
                      Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Height="4"
                      ResizeDirection="Rows"
                      IsVisible="False"
                      Background="{DynamicResource CardStrokeColorDefaultBrush}" />

        <AvaloniaEdit:TextEditor x:Name="EditorSecondary"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 ShowLineNumbers="True"
                                 IsVisible="False"
                                 FontSize="{Binding FontSize}"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 WordWrap="{Binding WordWrap}" />
    </Grid>
</UserControl>
